#!/bin/bash
# Pre-commit hook for repository validation and quality checks

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Get repository root
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

print_info "Starting pre-commit validation..."

# Check if validate_repo.py exists and is executable
VALIDATE_SCRIPT="scripts/validate_repo.py"
if [ -f "$VALIDATE_SCRIPT" ]; then
    print_info "Running repository validation..."
    if python3 "$VALIDATE_SCRIPT"; then
        print_info "Repository validation passed!"
    else
        print_error "Repository validation failed!"
        exit 1
    fi
else
    print_warning "Repository validation script not found: $VALIDATE_SCRIPT"
fi

# Check for basic Python syntax errors
print_info "Checking Python syntax..."
python_files="$(find . -name \"*.py\" -not -path \"./.venv/*\" -not -path \"./.git/*\" -not -path \"./tools/*\" -not -path \"./line/*\" | head -20)"

for py_file in $python_files; do
    if ! python3 -m py_compile "$py_file" 2>/dev/null; then
        print_error "Python syntax error in $py_file"
        exit 1
    fi
done
print_info "Python syntax check passed!"

# Check for obvious issues in shell scripts
print_info "Checking shell scripts..."
shell_files="$(find . -name \"*.sh\" -not -path \"./.venv/*\" -not -path \"./.git/*\" | head -10)"

for sh_file in $shell_files; do
    if [ -x "$sh_file" ]; then
        if ! bash -n "$sh_file" 2>/dev/null; then
            print_warning "Shell script $sh_file may have syntax issues (bash -n warning)"
        fi
    fi
done

# Check if we're in a git repository and have staged files
if git rev-parse --git-dir > /dev/null 2>&1; then
    staged_files="$(git diff --cached --name-only | head -20)"
    print_info "Validating staged changes..."
    
    for staged_file in $staged_files; do
        if [[ "$staged_file" == *.py ]]; then
            if [ ! -f "$staged_file" ]; then
                print_warning "File $staged_file was removed or renamed"
            elif ! python3 -m py_compile "$staged_file" 2>/dev/null; then
                print_error "Python syntax error in staged file: $staged_file"
                exit 1
            fi
        fi
    done
fi

print_info "Pre-commit validation complete!"

# Generate a summary of changes being committed
COMMIT_MESSAGE="$(git log -1 --pretty=%B | head -1 || echo "Uncommitted changes")"
echo "=== Pre-commit Validation Summary ==="
echo "Commit message: $COMMIT_MESSAGE"
echo "Repository root: $REPO_ROOT"
echo "Validation status: PASSED"
echo "===================================="

exit 0