{
  "language": "auto",
  "reload_config": true,
  "stats": {
    "enabled": true,
    "file": "stats.json",
    "write_seconds": 60
  },
  "window_title_regex": ".*Camfrog.*",
  "dry_run": false,
  "poll_seconds": 1.5,
  "log": {
    "level": "INFO",
    "file": "camfrog_auto.log",
    "max_bytes": 1000000,
    "backups": 3,
    "log_message_text": true
  },
  "active_hours": {
    "enabled": false,
    "start": "09:00",
    "end": "23:30"
  },
  "safety": {
    "stop_file": "STOP",
    "pid_file": "camfrog_auto.pid",
    "require_foreground": false,
    "restore_previous_window": true,
    "max_consecutive_failures": 5
  },
  "status": {
    "enabled": true,
    "edit": {
      "class_name": "Edit",
      "auto_id": "1001",
      "index": 0
    },
    "apply_button": null,
    "background_enter_target": "edit",
    "interval_seconds": 300,
    "set_on_start": true,
    "random": false,
    "language_mode": "both",
    "retry_seconds": 30,
    "max_length": 120,
    "messages": [
      {
        "th": "สวัสดีครับ ยินดีต้อนรับทุกคนเข้าห้องนะครับ ว่างคุยได้ ทักได้เลย",
        "en": "Welcome everyone to the room, free to chat so say hi anytime"
      },
      {
        "th": "กำลังฟังเพลงอยู่ ใครมีเพลงเพราะ ๆ แนะนำได้นะ",
        "en": "Listening to music, send me your favourite songs"
      },
      {
        "th": "สวัสดีตอนเย็น เวลา {time}",
        "en": "Good evening, it's {time}"
      },
      "Welcome! ยินดีต้อนรับ"
    ],
    "schedules": [],
    "language_cycle": [
      "th",
      "en"
    ],
    "marquee": {
      "enabled": true,
      "width": 28,
      "stride": 2,
      "step_seconds": 0.5,
      "separator": "   •   ",
      "cycles": 1,
      "max_frames": 80,
      "infinite_loop": false
    },
    "history": {
      "enabled": true,
      "file": "status_history.json",
      "max_items": 50,
      "record": true,
      "use_as_source": true,
      "seed_from_messages": true,
      "mode": "rotate"
    }
  },
  "autoreply": {
    "enabled": true,
    "own_nickname": "Seaza",
    "window_title_regex": ".*ZeaZDev.*",
    "log_kind": "room",
    "history_tail": 150,
    "history": {
      "class_name": "AtlAxWinLic140",
      "auto_id": "1002",
      "index": 0
    },
    "input": {
      "class_name": "AtlAxWinLic140",
      "auto_id": "1002",
      "index": 1
    },
    "ignore_nicknames": [],
    "only_nicknames": [],
    "per_sender_cooldown_seconds": 300,
    "global_min_gap_seconds": 20,
    "max_per_hour": 30,
    "delay_range_seconds": [
      2.0,
      5.0
    ],
    "max_reply_length": 200,
    "max_incoming_length": 500,
    "rules": [
      {
        "pattern": ".*",
        "mention": true,
        "reply": {
          "th": "ว่าไงครับ {sender} มีอะไรให้ช่วยไหม",
          "en": "Hey {sender}, how can I help?"
        },
        "cooldown_seconds": 120
      },
      {
        "pattern": "สวัสดี|หวัดดี|\\bhello\\b|\\bhi\\b|\\bhey\\b",
        "reply": {
          "th": [
            "สวัสดีครับคุณ {sender}",
            "หวัดดีครับ {sender} ยินดีต้อนรับ"
          ],
          "en": [
            "Hi {sender}, welcome!",
            "Hello {sender}!"
          ]
        },
        "cooldown_seconds": 60
      },
      {
        "pattern": "ราคา|เท่าไหร่|เท่าไร|\\bprice\\b|how much",
        "reply": {
          "th": "ทักแชทส่วนตัวได้เลยครับ {sender}",
          "en": "Please message me privately, {sender}"
        }
      },
      {
        "pattern": "ขอบคุณ|\\bthanks\\b|thank you",
        "reply": {
          "th": "ยินดีครับ {sender}",
          "en": "You're welcome, {sender}"
        }
      }
    ],
    "skip_patterns": [
      "\\bfree money\\b|เว็บพนัน"
    ],
    "ignore_links": true
  },
  "autoreply_im": {
    "enabled": false,
    "dry_run": true,
    "window_title_regex": "",
    "max_windows": 5,
    "log_kinds": [
      "im"
    ],
    "only_nicknames": [
      "zdevz"
    ],
    "rules": [
      {
        "pattern": ".*",
        "reply": {
          "th": "ตอนนี้ผมไม่ได้อยู่หน้าจอ เดี๋ยวกลับมาตอบนะครับ",
          "en": "I'm away from the screen right now, I'll reply when I'm back."
        }
      }
    ],
    "skip_patterns": [],
    "ignore_links": true,
    "prefix": "[auto] ",
    "answer_first_message": true,
    "per_sender_cooldown_seconds": 3600,
    "max_per_sender_per_day": 3,
    "global_min_gap_seconds": 20,
    "max_per_hour": 10,
    "delay_range_seconds": [
      2.0,
      5.0
    ],
    "max_reply_length": 200,
    "max_incoming_length": 500
  }
}
